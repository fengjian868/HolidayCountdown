<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
    <!-- 启用 ClassIsland.PluginSdk 内置的 CreateCipx target：
         dotnet build 后自动把 $(OutputPath) 打包为 .cipx，不含 runtime。 -->
    <CreateCipx>true</CreateCipx>
    <CipxPackageOutputName>HolidayCountdown.cipx</CipxPackageOutputName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 显式引用 Avalonia 使 XAMLIl 编译 targets 导入，支持 .axaml 代码后置。
         版本与 ClassIsland 2.2 主程序保持一致（Avalonia 12.1.0）。
         运行时由 ClassIsland 主程序提供，故 ExcludeAssets=runtime;native。 -->
    <PackageReference Include="Avalonia" Version="12.1.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- 插件元数据与资源文件复制到输出目录（CreateCipx 会打包整个输出目录） -->
    <None Include="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Plugin.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="icon.png" />
  </ItemGroup>
</Project>
