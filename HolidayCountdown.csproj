<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 显式引用 Avalonia 使 XAMLIl 编译 targets 导入，支持 .axaml 代码后置。
         版本与 ClassIsland 2.2 主程序保持一致（Avalonia 12.1.0）。
         运行时由 ClassIsland 主程序提供，故 ExcludeAssets=runtime;native。 -->
    <PackageReference Include="Avalonia" Version="12.1.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="icon.png" />
  </ItemGroup>
</Project>
